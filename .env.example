# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public address of the app, used in sign-up confirmation emails.
# Must also be listed under Supabase → Authentication → URL Configuration.
NEXT_PUBLIC_SITE_URL=

# Server only: used by cron jobs and the SMS outbox. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Africa's Talking SMS. Use AT_USERNAME=sandbox for testing.
# Leave empty to log SMS to the server console instead of sending.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
