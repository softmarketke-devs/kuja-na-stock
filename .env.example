# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public address of the app, used in sign-up confirmation emails.
# Must also be listed under Supabase → Authentication → URL Configuration.
NEXT_PUBLIC_SITE_URL=

# Server only: used by cron jobs and the SMS outbox. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Africa's Talking SMS. Use AT_USERNAME=sandbox for testing.
# Leave empty to log SMS to the server console instead of sending.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Public contact numbers shown on the site, international format without + or spaces (e.g. 2547XXXXXXXX).
# The call and WhatsApp buttons stay hidden while these are empty.
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Fish Audio (voice for the assistant). Leave the key empty to hide the microphone and speaker buttons.
# Server only. Optional: FISH_AUDIO_VOICE_ID picks a voice, FISH_AUDIO_MODEL defaults to s2.1-pro-free.
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_MODEL=

# Optional: map tile server, e.g. a MapTiler or Stadia URL ending in /{z}/{x}/{y}.png.
# Defaults to OpenStreetMap's own tiles, which are for light use only.
NEXT_PUBLIC_MAP_TILE_URL=
