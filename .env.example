# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public address of the app, used in sign-up confirmation emails.
# Must also be listed under Supabase → Authentication → URL Configuration.
NEXT_PUBLIC_SITE_URL=

# Server only: used by cron jobs and the SMS outbox. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Africa's Talking SMS. Use AT_USERNAME=sandbox for testing.
# Leave empty to log SMS to the server console instead of sending.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Public contact numbers shown on the site, international format without + or spaces (e.g. 2547XXXXXXXX).
# The call and WhatsApp buttons stay hidden while these are empty.
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# M-Pesa Express (Safaricom Daraja). Leave empty and the "Pay with M-Pesa" button says it is not switched on yet.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public https address of /api/mpesa/callback (Safaricom cannot reach localhost; use a tunnel while testing)
MPESA_CALLBACK_URL=
# A long random string. It is added to the callback address so only Safaricom's call is accepted.
MPESA_CALLBACK_SECRET=
